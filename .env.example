# ─── Deployer wallet ─────────────────────────────────────────────────────────
# Private key WITHOUT 0x prefix. The wallet that deploys the contract becomes
# the initial `owner`. The deployer should transfer ownership to a multi-sig
# (recommended) or to the Validocus governance wallet after deployment using
# `npm run script -- scripts/transfer-ownership.ts --network <net>`.
#
# NEVER COMMIT THIS FILE WITH A REAL PRIVATE KEY.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE_WITHOUT_QUOTES

# ─── Snowtrace verification ──────────────────────────────────────────────────
# Get a free API key at https://snowtrace.io/myapikey
# Required for `npm run verify:fuji` and `npm run verify:avalanche`.
SNOWTRACE_API_KEY=

# ─── Optional: initial authorized signers ────────────────────────────────────
# Comma-separated list of addresses that will be marked as
# "Validocus official" at deploy time. Empty = none (you can add later
# via `authorizeSigner(addr)` transactions).
#
# Example: 0xabc...,0xdef...
INITIAL_SIGNERS=

# ─── Optional: post-deploy ownership transfer ───────────────────────────────
# If set, the deploy script will automatically transfer ownership to this
# address after successful deployment. Leave empty to keep deployer as owner.
TRANSFER_OWNERSHIP_TO=

# ─── Optional: gas reporter ──────────────────────────────────────────────────
# Set REPORT_GAS=true to display gas costs in USD when running tests.
REPORT_GAS=false
